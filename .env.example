# Required for encrypted OAuth refresh tokens and runtime BYOK provider keys.
# Generate a high-entropy value, e.g. `openssl rand -base64 32`.
SUBZERO_ENCRYPTION_KEY=

# Google OAuth. Add http://localhost:3000/api/auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional server-side default. Runtime BYOK remains available in Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Local self-hosted SQLite location.
SUBZERO_DATABASE_URL=./data/subzero.db

# Optional host port for Docker (defaults to 3000).
SUBZERO_PORT=3000

# Demo mode is for tests and local product exploration only.
NEXT_PUBLIC_SUBZERO_DEMO_MODE=false
SUBZERO_DEMO_MODE=false
