{
  "name": "@subzero/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Subzero Mail primitives, tokens, and theme styles.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "./src/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  }
}
